import OMAReductions.R_Green14_W_3_14_R2

/-! Step Green14.W_3_14.R2.H1: every palindromic two-colouring of 175 or of 184 positions has a red
three-term progression or a blue fourteen-term progression (Ahmed, Kullmann and Snevily,
arXiv:1102.5433, Table 6).

The proof is a checked search. A state records the positions that may still be red (`allowed`)
and the positions known to be red (`redMask`); both stay symmetric, because every mark is applied
to a position and to its mirror image. Each fourteen-bit hint on the tape is one step: a red
conflict, a fourteen-term progression (closed when none of its positions may be red, forcing when
only one position or one mirror pair may be red), or a split on a position. The checker tests
every hint itself, so the search that produced the tape need not be trusted.

The bit-mask bookkeeping for red triples (`Shadows`, `shadowMask` and their lemmas) is adapted
from the Green14.W_3_12.R2.H1 proof in this repository, which adapts @VinnyMo's
Green14.W_3_11.R1.H2 checker. The symmetric steps, the tape format and the tapes are new. -/

namespace OMA.PalindromeSearch

def removeMask (allowed bad : Nat) := allowed ^^^ (allowed &&& bad)

structure Shadows where
  twice : Nat
  reverse : Nat
  even : Nat
  odd : Nat

def addShadow (p : Nat) (s : Shadows) : Shadows :=
  ⟨s.twice ||| (1 <<< (2*p)), s.reverse ||| (if p ≤ 255 then 1 <<< (255-p) else 0),
   s.even ||| (if p%2=0 then 1 <<< (p/2) else 0),
   s.odd ||| (if p%2=1 then 1 <<< (p/2) else 0)⟩

def shadowMask (s : Shadows) (p : Nat) :=
  removeMask ((s.twice >>> p) ||| ((s.reverse <<< (2*p)) >>> 255) |||
    (if p%2=0 then s.even <<< (p/2) else s.odd <<< (p/2+1))) (1 <<< p)

def bluePattern (a d : Nat) : Nat :=
  (List.range 14).foldr (fun t m => (1 <<< (a+t*d)) ||| m) 0

def NoTriple (R : ℕ → Prop) := ∀ a d, 0 < d → R a → R (a+d) → R (a+2*d) → False

lemma remove_safe {a b t : ℕ} (ha : a.testBit t = true) (hb : b.testBit t = false) :
    (removeMask a b).testBit t = true := by simp [removeMask, Nat.testBit_xor, ha, hb]

structure Represents (R : Nat → Prop) (s : Shadows) : Prop where
  twice : ∀ t, s.twice.testBit t = true → ∃ q, t=2*q ∧ R q
  reverse : ∀ t, s.reverse.testBit t = true → ∃ q, q≤255 ∧ t=255-q ∧ R q
  even : ∀ t, s.even.testBit t = true → R (2*t)
  odd : ∀ t, s.odd.testBit t = true → R (2*t+1)

lemma add_rep {R : Nat → Prop} {s : Shadows} (h : Represents R s) {p : ℕ} (hp : R p) :
    Represents R (addShadow p s) := by
  constructor
  · intro t ht
    simp only [addShadow,Nat.testBit_or,Bool.or_eq_true] at ht
    rcases ht with ht|ht
    · exact h.twice t ht
    · have e : 2*p=t := by simpa [Nat.shiftLeft_eq,Nat.testBit_two_pow] using ht
      exact ⟨p,e.symm,hp⟩
  · intro t ht
    simp only [addShadow,Nat.testBit_or,Bool.or_eq_true] at ht
    rcases ht with ht|ht
    · exact h.reverse t ht
    · split at ht
      · rename_i hb
        have e : 255-p=t := by simpa [Nat.shiftLeft_eq,Nat.testBit_two_pow] using ht
        exact ⟨p,hb,e.symm,hp⟩
      · simp at ht
  · intro t ht
    simp only [addShadow,Nat.testBit_or,Bool.or_eq_true] at ht
    rcases ht with ht|ht
    · exact h.even t ht
    · split at ht
      · rename_i hb
        have e : p/2=t := by simpa [Nat.shiftLeft_eq,Nat.testBit_two_pow] using ht
        rwa [show 2*t=p by omega]
      · simp at ht
  · intro t ht
    simp only [addShadow,Nat.testBit_or,Bool.or_eq_true] at ht
    rcases ht with ht|ht
    · exact h.odd t ht
    · split at ht
      · rename_i hb
        have e : p/2=t := by simpa [Nat.shiftLeft_eq,Nat.testBit_two_pow] using ht
        rwa [show 2*t+1=p by omega]
      · simp at ht

lemma no_midpoint {R : Nat → Prop} (h : NoTriple R) {a m b : ℕ}
    (ha : R a) (hm : R m) (hb : R b) (he : a+b=2*m) (hne : a≠b) : False := by
  by_cases hh : a < b
  · exact h a (m-a) (by omega) ha (by rwa [show a+(m-a)=m by omega])
      (by rwa [show a+2*(m-a)=b by omega])
  · exact h b (m-b) (by omega) hb (by rwa [show b+(m-b)=m by omega])
      (by rwa [show b+2*(m-b)=a by omega])

lemma shadow_safe {R : Nat → Prop} {s : Shadows} (hs : Represents R s) (hn : NoTriple R)
    {p t : Nat} (hp : R p) (ht : R t) : (shadowMask s p).testBit t = false := by
  by_cases e : p=t
  · simp [shadowMask,removeMask,Nat.testBit_xor,Nat.shiftLeft_eq,Nat.testBit_two_pow,e]
  have ep : (1 <<< p : Nat).testBit t = false := by simp [Nat.shiftLeft_eq,Nat.testBit_two_pow,e]
  simp only [shadowMask,removeMask,Nat.testBit_xor,Nat.testBit_and,ep,Bool.and_false,
    Bool.xor_false,Nat.testBit_or,Bool.or_eq_false_iff]
  refine ⟨⟨?_,?_⟩,?_⟩ <;> apply Bool.eq_false_iff.mpr <;> intro h
  · rw [Nat.testBit_shiftRight] at h
    obtain ⟨q,hq,hr⟩ := hs.twice _ h
    exact no_midpoint hn hp hr ht (by omega) e
  · rw [Nat.testBit_shiftRight, Nat.testBit_shiftLeft] at h
    simp only [Bool.and_eq_true,decide_eq_true_eq] at h
    obtain ⟨q,hb,hq,hr⟩ := hs.reverse _ h.2
    exact no_midpoint hn hr hp ht (by omega) (by omega)
  · split at h
    · rename_i hpar
      rw [Nat.testBit_shiftLeft] at h
      simp only [Bool.and_eq_true,decide_eq_true_eq] at h
      have hr := hs.even _ h.2
      exact no_midpoint hn hp ht hr (by omega) (by omega)
    · rename_i hpar
      rw [Nat.testBit_shiftLeft] at h
      simp only [Bool.and_eq_true,decide_eq_true_eq] at h
      have hr := hs.odd _ h.2
      exact no_midpoint hn hp ht hr (by omega) (by omega)

lemma pattern_has {t : ℕ} (ht : t < 14) (a d : ℕ) :
    (bluePattern a d).testBit (a+t*d) = true := by
  suffices ∀ xs : List ℕ, t ∈ xs →
      (xs.foldr (fun i m : ℕ => (1 <<< (a+i*d)) ||| m) 0).testBit (a+t*d) = true from
    this _ (List.mem_range.mpr ht)
  intro xs
  induction xs with
  | nil => simp
  | cons u xs ih =>
    intro hm
    rcases List.mem_cons.mp hm with rfl | h
    · simp [Nat.shiftLeft_eq, Nat.testBit_two_pow]
    · simp [ih h]

def baseMask (d : Nat) := if d = 0 then 1 else ((1 <<< (14*d))-1)/((1 <<< d)-1)

lemma base_correct : ∀ d : Fin 15, baseMask d.val = bluePattern 0 d.val := by decide +kernel

structure St where
  allowed : Nat
  redMask : Nat
  shadow : Shadows

def St.markRed (s : St) (p : Nat) : St :=
  ⟨removeMask s.allowed (shadowMask s.shadow p), s.redMask ||| (1 <<< p), addShadow p s.shadow⟩

def St.markBlue (s : St) (p : Nat) : St :=
  ⟨removeMask s.allowed (1 <<< p), s.redMask, s.shadow⟩

structure Compat (R : Nat → Prop) (s : St) : Prop where
  shadow : Represents R s.shadow
  red : ∀ x, s.redMask.testBit x = true → R x
  allowed : ∀ x, R x → s.allowed.testBit x = true

lemma compat_red {R : Nat → Prop} {s : St} (hs : Compat R s) (hn : NoTriple R) {p : Nat}
    (hp : R p) : Compat R (s.markRed p) := by
  refine ⟨add_rep hs.shadow hp, ?_, ?_⟩
  · intro x hx
    simp only [St.markRed, Nat.testBit_or, Bool.or_eq_true] at hx
    rcases hx with hx | hx
    · exact hs.red x hx
    · have e : p = x := by simpa [Nat.shiftLeft_eq, Nat.testBit_two_pow] using hx
      exact e ▸ hp
  · intro x hx
    exact remove_safe (hs.allowed x hx) (shadow_safe hs.shadow hn hp hx)

lemma compat_blue {R : Nat → Prop} {s : St} (hs : Compat R s) {p : Nat} (hp : ¬ R p) :
    Compat R (s.markBlue p) := by
  refine ⟨hs.shadow, hs.red, ?_⟩
  intro x hx
  apply remove_safe (hs.allowed x hx)
  have e : p ≠ x := fun h => hp (h ▸ hx)
  simp [Nat.shiftLeft_eq, e]

/-- The forcing step: the progression `a, a+d, ..., a+13*d` with its allowed positions `rest`. -/
def force (N : Nat) (s : St) (rest : Nat) : Option (List St) :=
  if rest = 0 then some [] else
  if rest.log2 < N ∧ (rest = 1 <<< rest.log2 ∨
      rest = (1 <<< rest.log2) ||| (1 <<< (N-1-rest.log2))) then
    some [(s.markRed rest.log2).markRed (N-1-rest.log2)]
  else none

def step (N h : Nat) (s : St) : Option (List St) :=
  if h &&& 3 = 0 then
    (if s.redMask &&& s.allowed = s.redMask then none else some [])
  else if h &&& 3 = 1 then
    (if 0 < h >>> 10 ∧ ((h >>> 2) &&& 255) + 13 * (h >>> 10) < N then
      force N s ((baseMask (h >>> 10) <<< ((h >>> 2) &&& 255)) &&& s.allowed)
    else none)
  else
    (if h >>> 2 < N then
      some [(s.markRed (h >>> 2)).markRed (N-1-(h >>> 2)),
        (s.markBlue (h >>> 2)).markBlue (N-1-(h >>> 2))]
    else none)

def search (N : Nat) : Nat → Nat → List St → Bool
  | _, _, [] => true
  | 0, _, _::_ => false
  | gas+1, tape, s::stack =>
    match step N (tape &&& 16383) s with
    | none => false
    | some kids => search N gas (tape >>> 14) (kids ++ stack)

structure Good (N : Nat) (R : Nat → Prop) : Prop where
  lt : ∀ x, R x → x < N
  sym : ∀ x, R x → R (N-1-x)
  noTriple : NoTriple R
  hits : ∀ a d, 0 < d → a + 13*d < N → ∃ t, ((baseMask d) <<< a).testBit t = true ∧ R t

lemma force_sound {N : Nat} {R : Nat → Prop} (g : Good N R) {s : St} {rest : Nat}
    {kids : List St} (hs : Compat R s) {t : Nat} (hrest : rest.testBit t = true) (ht : R t)
    (he : force N s rest = some kids) : ∃ k ∈ kids, Compat R k := by
  unfold force at he
  split at he
  · rename_i e
    rw [e] at hrest
    simp at hrest
  · split at he
    · rename_i hc
      obtain ⟨hpN, hor⟩ := hc
      cases he
      have hp : R rest.log2 := by
        generalize rest.log2 = p at hor hpN
        rcases hor with e | e
        · rw [e] at hrest
          have e2 : p = t := by simpa [Nat.shiftLeft_eq, Nat.testBit_two_pow] using hrest
          exact e2 ▸ ht
        · rw [e, Nat.testBit_or, Bool.or_eq_true] at hrest
          rcases hrest with h1 | h1
          · have e2 : p = t := by simpa [Nat.shiftLeft_eq, Nat.testBit_two_pow] using h1
            exact e2 ▸ ht
          · have e2 : N-1-p = t := by simpa [Nat.shiftLeft_eq, Nat.testBit_two_pow] using h1
            have h3 := g.sym t ht
            rwa [show N-1-t = p by omega] at h3
      exact ⟨_, List.mem_singleton.mpr rfl,
        compat_red (compat_red hs g.noTriple hp) g.noTriple (g.sym _ hp)⟩
    · cases he

lemma step_sound {N : Nat} {R : Nat → Prop} (g : Good N R) {h : Nat} {s : St}
    {kids : List St} (hs : Compat R s) (he : step N h s = some kids) :
    ∃ k ∈ kids, Compat R k := by
  unfold step at he
  split at he
  · split at he
    · cases he
    · rename_i hne
      exfalso
      apply hne
      apply Nat.eq_of_testBit_eq
      intro i
      rw [Nat.testBit_and]
      cases hb : s.redMask.testBit i with
      | false => rfl
      | true => simp [hs.allowed i (hs.red i hb)]
  · split at he
    · split at he
      · rename_i hcond
        obtain ⟨t, hbit, ht⟩ := g.hits _ _ hcond.1 hcond.2
        refine force_sound g hs (t := t) ?_ ht he
        rw [Nat.testBit_and, hbit, hs.allowed t ht]
        rfl
      · cases he
    · split at he
      · rename_i hz
        cases he
        by_cases hp : R (h >>> 2)
        · exact ⟨_, List.mem_cons_self,
            compat_red (compat_red hs g.noTriple hp) g.noTriple (g.sym _ hp)⟩
        · refine ⟨_, List.mem_cons_of_mem _ List.mem_cons_self,
            compat_blue (compat_blue hs hp) ?_⟩
          intro hq
          apply hp
          have h3 := g.sym _ hq
          rwa [show N-1-(N-1-(h >>> 2)) = h >>> 2 by omega] at h3
      · cases he

lemma search_sound {N : Nat} {R : Nat → Prop} (g : Good N R) (gas tape : Nat)
    (stack : List St) (hl : ∃ s ∈ stack, Compat R s) : search N gas tape stack = false := by
  induction gas generalizing tape stack with
  | zero =>
    rcases hl with ⟨s,hm,_⟩
    cases stack with
    | nil => simp at hm
    | cons => rfl
  | succ fuel ih =>
    rcases hl with ⟨v,hm,hv⟩
    cases stack with
    | nil => simp at hm
    | cons s stack =>
      simp only [search]
      split
      · rfl
      · rename_i kids e
        apply ih
        rcases List.mem_cons.mp hm with rfl | h
        · obtain ⟨w, hw, hc⟩ := step_sound g hv e
          exact ⟨w,List.mem_append_left _ hw,hc⟩
        · exact ⟨v,List.mem_append_right _ h,hv⟩

theorem mono_of_run (N gas tape : Nat) (hN : N ≤ 195)
    (hrun : search N gas tape [⟨2^N-1, 0, ⟨0,0,0,0⟩⟩] = true)
    (c : Nat → Bool) (hsym : ∀ x < N, c (N-1-x) = c x) :
    ∃ (b : Bool) (a d : Nat), 0 < d ∧ a + (if b then 2 else 13)*d < N ∧
      ∀ t ≤ (if b then 2 else 13), c (a+t*d) = b := by
  by_contra hmono
  have g : Good N (fun x => x < N ∧ c x = true) := by
    refine ⟨fun x h => h.1, ?_, ?_, ?_⟩
    · rintro x ⟨hx, hc⟩
      exact ⟨by omega, by rw [hsym x hx]; exact hc⟩
    · intro a d hd h0 h1 h2
      apply hmono
      refine ⟨true, a, d, hd, h2.1, ?_⟩
      intro t ht
      change t ≤ 2 at ht
      interval_cases t
      · simpa using h0.2
      · simpa using h1.2
      · simpa using h2.2
    · intro a d hd hb
      by_contra bad
      apply hmono
      refine ⟨false, a, d, hd, hb, ?_⟩
      intro t ht
      change t ≤ 13 at ht
      have hx : a+t*d < N := by have := Nat.mul_le_mul_right d ht; omega
      have hbit : ((baseMask d) <<< a).testBit (a+t*d) = true := by
        rw [base_correct ⟨d, by omega⟩]
        simpa [Nat.testBit_shiftLeft, Nat.le_add_right] using pattern_has (by omega : t < 14) 0 d
      cases e : c (a+t*d) with
      | false => rfl
      | true => exact (bad ⟨_, hbit, hx, e⟩).elim
  have hc : Compat (fun x => x < N ∧ c x = true) ⟨2^N-1, 0, ⟨0,0,0,0⟩⟩ := by
    refine ⟨?_, ?_, ?_⟩
    · constructor <;> simp
    · intro x hx
      simp at hx
    · intro x hx
      rw [Nat.testBit_two_pow_sub_one]
      exact decide_eq_true hx.1
  have hf := search_sound g gas tape [⟨2^N-1, 0, ⟨0,0,0,0⟩⟩] ⟨_, List.mem_cons_self, hc⟩
  rw [hrun] at hf
  cases hf

def tape175 : Nat := 

set_option maxRecDepth 100000 in
lemma run175 : search 175 17497 tape175 [⟨2^175-1, 0, ⟨0,0,0,0⟩⟩] = true := by
  decide +kernel

def tape184 : Nat := 

set_option maxRecDepth 100000 in
lemma run184 : search 184 26050 tape184 [⟨2^184-1, 0, ⟨0,0,0,0⟩⟩] = true := by
  decide +kernel

end OMA.PalindromeSearch

open OMA.PalindromeSearch in
theorem OMA.solution : OMA.R_Green14_W_3_14_R2.H1 := by
  intro n hn c hsym
  rcases hn with rfl | rfl
  · exact mono_of_run 175 _ tape175 (by norm_num) run175 c hsym
  · exact mono_of_run 184 _ tape184 (by norm_num) run184 c hsym
